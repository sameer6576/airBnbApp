{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "Airbnb Hotel Booking API",
    "description": "API collection for airBnbApp.\n\n1. Import this + AirbnbApp.local.postman_environment.json\n2. Pick Local env\n3. Manager: login → hotel → room → activate → (optional) create another room after activate\n4. Guest: login → search → init → payments (guests optional) → Stripe CLI for confirm\n5. Cancel works on unpaid holds (releases inventory) or confirmed (refund policy)\n\nResponses: { timeStamp, data, error }. Don't fake Stripe webhook signatures.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080/api/v1" }],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup Guest",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{guestEmail}}\",\n  \"password\": \"{{guestPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "Login Guest",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const body = pm.response.json();", "  const token = body.data ? body.data.accessToken : body.accessToken;", "  if (token) pm.environment.set('accessToken', token);", "  const profile = body.data || body;", "  if (profile.id) pm.environment.set('userIdToPromote', String(profile.id));", "}"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{guestEmail}}\",\n  \"password\": \"{{guestPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Manager",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const body = pm.response.json();", "  const token = body.data ? body.data.accessToken : body.accessToken;", "  if (token) pm.environment.set('accessToken', token);", "}"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const body = pm.response.json();", "  const token = body.data ? body.data.accessToken : body.accessToken;", "  if (token) pm.environment.set('accessToken', token);", "}"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login",
            "description": "Seeded ADMIN user for promote-manager."
          }
        },
        {
          "name": "Refresh Access Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const body = pm.response.json();", "  const token = body.data ? body.data.accessToken : body.accessToken;", "  if (token) pm.environment.set('accessToken', token);", "}"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create Hotel",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201 || pm.response.code === 200) {", "  const hotel = (pm.response.json().data || pm.response.json());", "  if (hotel.id) pm.environment.set('hotelId', String(hotel.id));", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Skyline Suites\",\n  \"city\": \"{{city}}\",\n  \"photos\": [\"https://example.com/hotel.jpg\"],\n  \"amenities\": [\"wifi\", \"pool\", \"parking\"],\n  \"contactInfo\": {\n    \"address\": \"100 Broadway\",\n    \"phoneNumber\": \"+1-555-0100\",\n    \"email\": \"stay@skylinesuites.example\",\n    \"location\": \"Manhattan\"\n  }\n}" },
            "url": "{{baseUrl}}/admin/hotels"
          }
        },
        {
          "name": "Create Room",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201 || pm.response.code === 200) {", "  const room = (pm.response.json().data || pm.response.json());", "  if (room.id) pm.environment.set('roomId', String(room.id));", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"Deluxe King\",\n  \"basePrice\": 150.00,\n  \"photos\": [\"https://example.com/room.jpg\"],\n  \"amenities\": [\"king bed\", \"ensuite\"],\n  \"totalCount\": 5,\n  \"capacity\": 2\n}" },
            "url": "{{baseUrl}}/admin/hotels/{{hotelId}}/rooms"
          }
        },
        {
          "name": "Activate Hotel",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/admin/hotels/{{hotelId}}/activate" }
        },
        {
          "name": "Create Room After Activate",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201 || pm.response.code === 200) {", "  const room = (pm.response.json().data || pm.response.json());", "  if (room.id) pm.environment.set('roomId', String(room.id));", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"Standard Twin\",\n  \"basePrice\": 120.00,\n  \"photos\": [\"https://example.com/twin.jpg\"],\n  \"amenities\": [\"twin beds\"],\n  \"totalCount\": 4,\n  \"capacity\": 2\n}" },
            "url": "{{baseUrl}}/admin/hotels/{{hotelId}}/rooms",
            "description": "Hotel already active → inventory for ~1 year is created automatically."
          }
        },
        {
          "name": "Update Room Inventory",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"startDate\": \"{{checkInDate}}\",\n  \"endDate\": \"{{checkOutDate}}\",\n  \"surgeFactor\": 1.1,\n  \"closed\": false\n}" },
            "url": "{{baseUrl}}/admin/inventory/rooms/{{roomId}}"
          }
        },
        {
          "name": "Bulk Update Hotel Inventory",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"startDate\": \"{{checkInDate}}\",\n  \"endDate\": \"{{checkOutDate}}\",\n  \"surgeFactor\": 1.2,\n  \"closed\": false\n}" },
            "url": "{{baseUrl}}/admin/inventory/hotels/{{hotelId}}",
            "description": "Applies surge/closed to all rooms in the hotel for the date range."
          }
        },
        {
          "name": "Hotel Analytics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/hotels/{{hotelId}}/analytics?startDate=2026-01-01&endDate=2026-12-31"
          }
        },
        {
          "name": "Hotel Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/hotels/{{hotelId}}/reports?startDate=2026-01-01&endDate=2026-12-31"
          }
        },
        {
          "name": "Promote User To Manager",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/users/{{userIdToPromote}}/promote-manager",
            "description": "Requires ADMIN token (Login Admin first). Set userIdToPromote from guest profile/login."
          }
        }
      ]
    },
    {
      "name": "Browse & Book",
      "item": [
        {
          "name": "Search Hotels (filters + sort)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"{{city}}\",\n  \"startDate\": \"{{checkInDate}}\",\n  \"endDate\": \"{{checkOutDate}}\",\n  \"roomsCount\": 1,\n  \"minPrice\": 50,\n  \"maxPrice\": 400,\n  \"minRating\": 0,\n  \"minCapacity\": 2,\n  \"amenities\": [\"wifi\"],\n  \"sortBy\": \"PRICE_ASC\",\n  \"page\": 0,\n  \"size\": 10\n}"
            },
            "url": "{{baseUrl}}/hotels/search",
            "description": "Filters: minPrice, maxPrice, minRating, minCapacity, amenities. sortBy: PRICE_ASC | PRICE_DESC | RATING_DESC"
          }
        },
        {
          "name": "Hotel Info",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/hotels/{{hotelId}}/info"
          }
        },
        {
          "name": "Init Booking (Idempotent)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const booking = (pm.response.json().data || pm.response.json());", "  if (booking.id) pm.environment.set('bookingId', String(booking.id));", "}"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": {{hotelId}},\n  \"roomId\": {{roomId}},\n  \"checkInDate\": \"{{checkInDate}}\",\n  \"checkOutDate\": \"{{checkOutDate}}\",\n  \"roomsCount\": 1\n}"
            },
            "url": "{{baseUrl}}/bookings/init",
            "description": "Send the same Idempotency-Key on retry to reuse the same booking without double-reserving."
          }
        },
        {
          "name": "Init Booking Retry (same key)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const booking = (pm.response.json().data || pm.response.json());", "  if (booking.id) pm.environment.set('bookingId', String(booking.id));", "}"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": {{hotelId}},\n  \"roomId\": {{roomId}},\n  \"checkInDate\": \"{{checkInDate}}\",\n  \"checkOutDate\": \"{{checkOutDate}}\",\n  \"roomsCount\": 1\n}"
            },
            "url": "{{baseUrl}}/bookings/init",
            "description": "Should return the same bookingId as Init Booking (Idempotent)."
          }
        },
        {
          "name": "Create Guest",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201 || pm.response.code === 200) {", "  const guest = (pm.response.json().data || pm.response.json());", "  if (guest.id) pm.environment.set('guestId', String(guest.id));", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alice Traveler\",\n  \"gender\": \"FEMALE\",\n  \"age\": 28\n}" },
            "url": "{{baseUrl}}/guests"
          }
        },
        {
          "name": "Add Guests to Booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "[\n  { \"id\": {{guestId}} },\n  { \"name\": \"Bob Traveler\", \"gender\": \"MALE\", \"age\": 30 }\n]" },
            "url": "{{baseUrl}}/bookings/{{bookingId}}/addGuests",
            "description": "Optional. You can skip guests and go straight to Initiate Payment."
          }
        },
        {
          "name": "Modify Booking Dates",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkInDate\": \"{{checkInDate}}\",\n  \"checkOutDate\": \"{{checkOutDate}}\",\n  \"roomsCount\": 1\n}"
            },
            "url": "{{baseUrl}}/bookings/{{bookingId}}/dates"
          }
        },
        {
          "name": "Cancellation Quote",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings/{{bookingId}}/cancellation-quote",
            "description": "Unpaid holds → $0 refund. Confirmed → policy-based estimate."
          }
        },
        {
          "name": "Initiate Payment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/{{bookingId}}/payments",
            "description": "Guests not required. Extends soft hold (~30 min by default) so Stripe Checkout has time."
          }
        },
        {
          "name": "Booking Status",
          "request": { "method": "GET", "url": "{{baseUrl}}/bookings/{{bookingId}}/status" }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel",
            "description": "Works on RESERVED / GUEST_ADDED / PAYMENT_PENDING (releases hold, no refund) or CONFIRMED (policy refund)."
          }
        }
      ]
    },
    {
      "name": "Wishlist & Reviews",
      "item": [
        {
          "name": "Add Hotel To Wishlist",
          "request": { "method": "POST", "url": "{{baseUrl}}/wishlists/hotels/{{hotelId}}" }
        },
        {
          "name": "List Wishlist",
          "request": { "method": "GET", "url": "{{baseUrl}}/wishlists" }
        },
        {
          "name": "Remove Hotel From Wishlist",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/wishlists/hotels/{{hotelId}}" }
        },
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Great stay, clean rooms and friendly staff.\"\n}" },
            "url": "{{baseUrl}}/bookings/{{bookingId}}/reviews",
            "description": "Requires CONFIRMED booking after check-out date."
          }
        },
        {
          "name": "List Hotel Reviews",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/hotels/{{hotelId}}/reviews"
          }
        },
        {
          "name": "My Reviews",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/myReviews" }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "My Profile",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const profile = (pm.response.json().data || pm.response.json());", "  if (profile.id) pm.environment.set('userIdToPromote', String(profile.id));", "}"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/users/getMyProfile" }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Guest\",\n  \"dateOfBirth\": \"1995-05-15\",\n  \"gender\": \"OTHER\"\n}" },
            "url": "{{baseUrl}}/users/profile"
          }
        },
        {
          "name": "My Bookings",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/myBookings" }
        }
      ]
    },
    {
      "name": "Webhook",
      "description": "Use Stripe CLI:\n```\nstripe listen --forward-to localhost:8080/api/v1/webhook/payment\n```",
      "item": [
        {
          "name": "Stripe CLI note (placeholder)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/hotels/{{hotelId}}/info",
            "description": "Placeholder. Confirm payments via Stripe CLI webhook forwarder."
          }
        }
      ]
    }
  ]
}
